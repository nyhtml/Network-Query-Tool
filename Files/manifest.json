{
  "name": "Network Query Tool",
  "short_name": "Network Query Tool",
  "description": "Professional online diagnostic tools to check various connections and network health.",
  "id": "com.sipylus.nqt",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#0ea5e9",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "android",
      "url": "https://play.google.com/store/apps/details?id=com.sipylus.nqt",
      "id": "com.sipylus.nqt"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate"
  },

  "edge_side_panel": {
    "preferred_width": 480
  },


